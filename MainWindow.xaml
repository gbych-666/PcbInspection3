<Window x:Class="PcbInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCB 视觉检测控制平台" 
        Height="1200" Width="1450"
        MinWidth="725" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5"
        Icon="/Resources/app.ico"
        ResizeMode="CanResize">

    <!-- 1. 资源定义 -->
    <Window.Resources>
        <!-- 导航按钮样式 -->
        <Style x:Key="ToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" Padding="20,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4E657A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- 2. 使用 Viewbox 实现整体 UI 矢量等比例缩放 -->
    <Viewbox Stretch="Uniform">
        <!-- 内部主 Grid 设置固定的基准设计尺寸 (1450 x 1200) -->
        <Grid Width="1450" Height="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 顶部状态栏 -->
            <Border Grid.Row="0" Background="#2C3E50" Padding="15,0">
                <Grid>
                    <TextBlock Text="PCB 视觉检测控制平台" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="当前登录：" Foreground="#BDC3C7" FontSize="16"/>
                        <TextBlock x:Name="TxtCurrentUser" Text="操作员" Foreground="#2ECC71" FontSize="14" FontWeight="Bold" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 主界面内容区 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Background="#34495E">
                    <StackPanel Margin="0,10,0,0">
                        <RadioButton Content="📷  检测界面" Height="50" Foreground="White" FontSize="15"  Style="{StaticResource ToggleButtonStyle}" IsChecked="True" Click="NavDetect_Click" Checked="RadioButton_Checked"/>
                        <RadioButton Content="⚙️  配置调试" Height="50" Foreground="White" FontSize="15"   Style="{StaticResource ToggleButtonStyle}" Click="NavConfig_Click"/>
                        <RadioButton Content="📊  数据查询" Height="50" Foreground="White" FontSize="15"  Style="{StaticResource ToggleButtonStyle}" Click="NavData_Click"/>
                    </StackPanel>
                </Border>
                <!-- 主内容显示区 -->
                <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Viewbox>
</Window>