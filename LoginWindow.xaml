<Window x:Class="PcbInspection.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="360" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FA"
        Icon="/Resources/app.ico" >
    <Border Padding="30" CornerRadius="8" Background="White" Margin="0">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC" BlurRadius="15" ShadowDepth="2" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Text="PCB 元件完整性视觉检测系统" FontSize="20" FontWeight="Bold" 
                       Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- 表单区 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用户角色：" VerticalAlignment="Center" Foreground="#34495E" FontSize="14"/>
                    <ComboBox x:Name="CmbRole" Grid.Column="1" Height="34" FontSize="14" VerticalContentAlignment="Center" SelectedIndex="0">
                        <ComboBoxItem Content="操作员"/>
                        <ComboBoxItem Content="管理员"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="登录密码：" VerticalAlignment="Center" Foreground="#34495E" FontSize="14"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Column="1" Height="34" FontSize="14" VerticalContentAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="TxtError" Foreground="#E74C3C" FontSize="12" Margin="80,5,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 登录按钮 -->
            <Button Grid.Row="2" Content="登 录" Height="38"  IsDefault="True"  Background="#3498DB" Foreground="White" 
                    FontSize="16" FontWeight="Bold" Click="BtnLogin_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>