<Page x:Class="PcbInspection.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="DataPage"
      Background="#F0F2F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 1. 查询条件 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 查询日期 -->
                <TextBlock Grid.Column="0" Text="日期查询：" VerticalAlignment="Center"
                           FontSize="14"  FontWeight="Bold" Foreground="#333333"  Margin="0,0,8,0"/>
                <DatePicker x:Name="DatePickerQuery" Grid.Column="1" Width="150" Height="35"  FontSize="14"  Margin="0,0,10,0"/>
                <Button x:Name="BtnQueryDay" Grid.Column="2" Content="查询当天"  Width="100"  Height="35" Background="#3498DB"
                        Foreground="White" FontWeight="Bold" Margin="0,0,30,0" Click="BtnQueryDay_Click"/>
                <!-- 月份查询 -->
                <TextBlock Grid.Column="3" Text="月份查询：" VerticalAlignment="Center" FontSize="14"  FontWeight="Bold" Foreground="#333333" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <ComboBox x:Name="CmbYear" Width="90"  Height="35" FontSize="14"  Margin="0,0,5,0"/>
                    <ComboBox x:Name="CmbMonth"
                              Width="70"
                              Height="35"
                              FontSize="14"
                              Margin="0,0,10,0"/>
                    <Button x:Name="BtnQueryMonth"
                            Content="查询月份"
                            Width="100"
                            Height="35"
                            Background="#8E44AD"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnQueryMonth_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 2. 当前查询结果统计 -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- 查询日期 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtQueryTitle"
                               Text="当天统计"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#333333"/>
                    <TextBlock x:Name="TxtQueryDate"
                               Text="2026-09-07"
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <!-- 总数 -->
                <Border Grid.Column="1"
                        Background="#F5F6F7"
                        CornerRadius="5"
                        Margin="5,0"
                        Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="总数"
                                   FontSize="12"
                                   Foreground="#777777"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtQueryTotal"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 良品 -->
                <Border Grid.Column="2"
                        Background="#EAF8EF"
                        CornerRadius="5"
                        Margin="5,0"
                        Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="良品数"
                                   FontSize="12"
                                   Foreground="#2E8B57"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtQueryPass"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#2ECC71"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 不良 -->
                <Border Grid.Column="3"
                        Background="#FDEDEC"
                        CornerRadius="5"
                        Margin="5,0"
                        Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="不良品数"
                                   FontSize="12"
                                   Foreground="#C0392B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtQueryNg"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 良品率 -->
                <Border Grid.Column="4"  Background="#EBF5FB" CornerRadius="5" Margin="5,0" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="良品率" FontSize="12" Foreground="#2980B9" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtQueryRate" Text="0.00%"  FontSize="24" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <!-- 3. 图表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 3.1 饼图 -->
            <Border Grid.Column="0" Background="White" CornerRadius="6"  Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtPieTitle" Text="良品 / 不良品" FontSize="16"  FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                    <lvc:PieChart x:Name="PieChartResult" Grid.Row="1" LegendPosition="Bottom" InitialRotation="0" MaxAngle="360" MinValue="0"/>
                </Grid>
            </Border>
            <!-- 3.2 月度曲线图 -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLineTitle" Text="月度检测趋势" FontSize="16" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,10"/>
                    <lvc:CartesianChart x:Name="MonthLineChart"  Grid.Row="1" LegendPosition="Bottom"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
 
