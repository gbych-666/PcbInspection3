<Page x:Class="PcbInspection.Pages.DetectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DetectPage" Background="#F0F2F5">
    <Grid Height="900" Width="1200">
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 1. 图像显示区域-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- 1.1 实时画面区 -->
            <Border Grid.Column="0" Height="350" Width="490" Background="Black" CornerRadius="6">
                <Grid>
                    <Image x:Name="ImgLive" Stretch="Uniform"/>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#80000000" Padding="10,5" Margin="10">
                        <TextBlock Text="● 实时画面 (Live)" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
            <!-- 1.2 静态拍照及检测叠加区 -->
            <Border Grid.Column="2" Height="350" Width="490" Background="Black" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="GridCaptureContainer">
                    <!-- 检测图片： Fill = 强制铺满整个 490×350 区域  此时图片显示区域与 Canvas 完全重合 -->
                    <Image x:Name="ImgCapture" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="ImgCapture_SizeChanged"/>
                    <!-- ROI覆盖层： 与 Image 完全处于同一个 Grid 默认 Stretch，因此尺寸与 Image 控件一致-->
                    <Canvas x:Name="CanvasDetectRoi" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         ClipToBounds="True" IsHitTestVisible="False"/>
                    <!-- 左上角标题 -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#80000000" Padding="10,5"  Margin="10">
                        <TextBlock Text="📷 检测图像 (Snapshot)" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- 2. 操作控制面板 -->
        <Border Grid.Row="1" Background="White" Margin="0,10,0,0" Padding="10" CornerRadius="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="检测项目:" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbProjects" Width="180" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <Button x:Name="BtnLive" Content="开始采集" Width="110" Height="38" Margin="0,0,15,0" 
                        Background="#2ECC71" Foreground="White" FontSize="14" FontWeight="Bold" 
                        Click="BtnToggleLive_Click"/>

                <Button x:Name="BtnStartDetect" Content="开始检测" Width="120" Height="38" Margin="0,0,0,0" 
                        Background="#E67E22" Foreground="White" FontSize="14" FontWeight="Bold"
                        Click="BtnStartDetect_Click"/>
            </StackPanel>
        </Border>
        <!-- 3. 当日检测统计 -->
        <Grid Grid.Row="2" Margin="0,5,0,5">
            <Border Background="White" CornerRadius="6" Padding="15,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <!-- 标题 -->
                    <Grid  Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="📊 当日统计"  FontSize="26" FontWeight="Bold" Foreground="#333333" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtStatisticsDate"  Text="----/--/--"  FontSize="12" Foreground="#999999"  Margin="180,10,0,0"/>
                    </Grid>
                    <!-- 总数 -->
                    <Border Grid.Column="1" Background="#F5F6F7" CornerRadius="5" Margin="5,0" Padding="15,5">
                        <StackPanel >
                            <TextBlock Text="总数"
                               FontSize="20"
                               Foreground="#777777"
                               HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotalCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 良品数 -->
                    <Border Grid.Column="2"
                    Background="#EAF8EF"
                    CornerRadius="5"
                    Margin="5,0"
                    Padding="15,5">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="良品数"
                               FontSize="20"
                               Foreground="#2E8B57"
                               HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtPassCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2ECC71"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>


                    <!-- 不良品数 -->
                    <Border Grid.Column="3"
                    Background="#FDEDEC"
                    CornerRadius="5"
                    Margin="5,0"
                    Padding="15,5">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="不良品数"
                               FontSize="20"
                               Foreground="#C0392B"
                               HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtNgCount"
                               Text="0"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#E74C3C"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 良品率 -->
                    <Border Grid.Column="4"
                    Background="#EBF5FB"
                    CornerRadius="5"
                    Margin="5,0"
                    Padding="15,5">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="良品率"
                               FontSize="20"
                               Foreground="#2980B9"
                               HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPassRate"
                               Text="0.00%"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#3498DB"
                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- 4. 检测结果展示区 -->
        <Border Grid.Row="3" Background="White" Margin="0,10,0,10" Padding="15" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 大结果状态面板 -->
                <Border x:Name="BorderResultStatus" Grid.Column="0" Background="#BDC3C7" CornerRadius="6" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtResultStatus" Text="等待检测" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtResultTime" Text="--" Foreground="White" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 详细检测日志面板 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📋 区域比对明细：" FontSize="14" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,5"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="TxtDetectLogs" IsReadOnly="True" BorderThickness="1" BorderBrush="#E0E0E0" 
                                 Background="#F9F9F9" FontFamily="Consolas" FontSize="13" Padding="8" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>